# Production environment variables for EightChat
# Set these as Render environment variables; never commit real values to Git.

# ── Server ──────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Native mobile requests do not need browser CORS. Keep this restricted.
CLIENT_URL=https://eightchat.invalid

# ── JWT (generate with: openssl rand -base64 64) ───
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_64_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Neon PostgreSQL ──────────────────────────────────
# Get these fields from Neon's direct connection string (not the -pooler host).
POSTGRES_HOST=ep-xxxx.region.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=eightchat
POSTGRES_USER=eightchat_owner
POSTGRES_PASSWORD=REPLACE_WITH_NEON_PASSWORD
POSTGRES_SSL=true

# ── Upstash Redis ────────────────────────────────────
# Get the TLS Redis URL from Upstash's ioredis connection details.
REDIS_URL=rediss://default:REPLACE_PASSWORD@REPLACE_HOST.upstash.io:6379

# ── Cloudinary ───────────────────────────────────────
# Get from: https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ── Sentry (optional but recommended) ───────────────
# Get from: https://sentry.io → Project → DSN
SENTRY_DSN=https://XXXX@oXXXX.ingest.sentry.io/XXXX
