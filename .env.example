# Server
NODE_ENV=development
PORT=3000
SERVER_URL=http://localhost:3000
CLIENT_URL=http://localhost:8081

# JWT — replace both values before deployment
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eightchat
POSTGRES_USER=eightchat
POSTGRES_PASSWORD=eightchat_password

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=eightchat_redis_secret
